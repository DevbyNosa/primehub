PORT=3000
NODE_ENV=development

# Express session
SESSION_SECRET=replace-with-a-long-random-secret

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=primehub_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-database-password

# Frontend URL used for CORS and payment redirects
CLIENT_URL=http://localhost:5173

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-api-key
CLOUDINARY_API_SECRET=replace-with-your-api-secret

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Flutterwave
FLW_PUBLIC_KEY=replace-with-your-flutterwave-public-key
FLW_SECRET_KEY=replace-with-your-flutterwave-secret-key
FLW_ENCRYPTION_KEY=replace-with-your-flutterwave-encryption-key
